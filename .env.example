# Copy to .env and edit. .env is git-ignored. Never commit keys.
# Every setting here can also live in strategy.json (see strategy.example.json); env wins.

# --- Safety ---
# Anything except an explicit "false" keeps the bot in dry-run: quotes only, no signing, no sending.
DRY_RUN=true

# --- Strategy ---
# Token to trade against SOL. Default is JUP.
TOKEN_MINT=JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN
# Unit for BUY_PRICE: USDC or SOL (price of ONE token)
PRICE_UNIT=USDC
# Buy when the executable price is at or below this
BUY_PRICE=0.20
TAKE_PROFIT_PCT=20
STOP_LOSS_PCT=10
# Size of one position in SOL
MAX_POSITION_SOL=0.01
POLL_INTERVAL_SEC=15
SLIPPAGE_BPS=100
COOLDOWN_SEC_AFTER_SELL=60
# Safety stops: exit after this many trades, or this many errors in a row
MAX_TRADES=10
MAX_CONSECUTIVE_ERRORS=5

# --- Live mode only ---
RPC_URL=https://api.mainnet-beta.solana.com
# Path to a keypair file (JSON byte array or base58). Use a small burner wallet.
KEYPAIR_PATH=
# jito = send through the Jito block engine with a tip; rpc = plain RPC
SEND_VIA=jito
# If Jito refuses the send, retry once over RPC without a tip
FALLBACK_TO_RPC=true
JITO_TIP_LAMPORTS=10000
# Optional Jito UUID from a whitelist ticket. Leave empty without one.
JITO_UUID=
BLOCK_ENGINE_URL=https://tokyo.mainnet.block-engine.jito.wtf
PRIORITY_FEE_LAMPORTS=10000
# Refuse live swaps that would leave less than this much SOL
MIN_SOL_RESERVE=0.003

# --- Jupiter ---
# Keyless public endpoint. For api.jup.ag set JUPITER_API_URL=https://api.jup.ag/swap/v1 and a key.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
