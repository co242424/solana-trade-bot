# Copy to .env and edit. .env is git-ignored. Never commit keys.
# Strategy settings (which strategy, params, sizes, TP/SL, limits) live in strategy.json
# (copy strategy.example.json) and can be edited from the dashboard. This file holds the mode,
# secrets, connections and the hard safety caps.

# --- Safety ---
# Anything except an explicit "false" keeps everything in dry-run: quotes and paper fills only.
DRY_RUN=true
# Live perps need BOTH DRY_RUN=false and this flag.
ENABLE_LIVE_PERPS=false
# Perps caps. The dashboard and strategy.json cannot go above these.
# MAX_LEVERAGE has a hard cap of 3 in code; MAX_PERP_COLLATERAL_USD a hard cap of 100 (Jupiter minimum is 10).
MAX_LEVERAGE=2
MAX_PERP_COLLATERAL_USD=15
# The bot stops after this many errors in a row
MAX_CONSECUTIVE_ERRORS=5
# Refuse live swaps that would leave less than this much SOL
MIN_SOL_RESERVE=0.003

# --- Wallet and RPC (live mode only) ---
RPC_URL=https://api.mainnet-beta.solana.com
# Path to a keypair file (JSON byte array or base58). Use a small burner wallet.
KEYPAIR_PATH=

# --- Spot sending ---
# jito = send through the Jito block engine with a tip; rpc = plain RPC
SEND_VIA=jito
FALLBACK_TO_RPC=true
JITO_TIP_LAMPORTS=10000
# Optional Jito UUID from a whitelist ticket. Leave empty without one.
JITO_UUID=
BLOCK_ENGINE_URL=https://tokyo.mainnet.block-engine.jito.wtf
PRIORITY_FEE_LAMPORTS=10000

# --- Jupiter ---
# Keyless public swap endpoint. For api.jup.ag set JUPITER_API_URL=https://api.jup.ag/swap/v1 and a key.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
PERPS_API_URL=https://perps-api.jup.ag/v2

# --- One-shot swap CLI defaults (npm run swap) ---
TOKEN_MINT=JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN
SLIPPAGE_BPS=100

# --- Dashboard (always bound to 127.0.0.1) ---
DASHBOARD_PORT=8787
