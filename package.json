{
  "name": "solana-trade-bot",
  "version": "0.2.0",
  "description": "Solana trading bot: pluggable strategies (grid, MA, RSI, Bollinger, Donchian, DCA, price trigger) on Jupiter spot, Jupiter Perps with hard caps, local dashboard, backtests. Dry-run by default.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "bot": "node --import tsx src/bot.ts",
    "dashboard": "node --import tsx src/dashboard/server.ts",
    "swap": "node --import tsx src/swap.ts",
    "perps": "node --import tsx src/perpsCli.ts",
    "kill": "node --import tsx src/kill.ts",
    "backtest": "node --import tsx backtest/run.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/co242424/solana-trade-bot.git"
  },
  "bugs": {
    "url": "https://github.com/co242424/solana-trade-bot/issues"
  },
  "homepage": "https://github.com/co242424/solana-trade-bot#readme"
}
