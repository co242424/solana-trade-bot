{
  "name": "solana-trade-bot",
  "version": "0.1.0",
  "description": "Small, honest Solana auto buy/sell bot: Jupiter quotes and swaps, optional Jito landing, dry-run by default",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "swap": "node --import tsx src/swap.ts",
    "bot": "node --import tsx src/bot.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
